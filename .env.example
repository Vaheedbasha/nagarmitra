# ---------------------------------------------------------------------------
# NagarMitra environment configuration
# Copy to .env:  cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
SESSION_DAYS=7

# Persistence (SQLite file, created automatically)
DATABASE_PATH=server/data/nagarmitra.db
UPLOAD_DIR=server/uploads
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=41943040

# Initial administrator. REQUIRED in production on first start.
ADMIN_EMAIL=admin@nagarmitra.local
ADMIN_PASSWORD=replace-with-a-long-random-password
# Password for the seeded demo citizens (development only)
DEMO_CITIZEN_PASSWORD=Citizen@12345

# AI (OpenAI-compatible provider). Leave AI_API_KEY empty to run with the
# transparent rule-based fallback; the UI states clearly when AI is inactive.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Frontend (Vite exposes only VITE_* to the browser)
# Leave empty in development (Vite proxies /api to the server on 8787).
VITE_API_URL=
# Optional map tile override. Default is OpenStreetMap.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Public URL of the deployed app (used in documentation/links)
PUBLIC_APP_URL=http://127.0.0.1:5173
